<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:label="@string/app_name" android:icon="@drawable/foto" android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar"
        android:supportsRtl="true" android:enabled="true">
        <activity android:name="FotoCalcActivity"
                  android:label="@string/app_name" android:icon="@drawable/foto"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="ResultScreen" android:icon="@drawable/foto"></activity>
    </application>
</manifest>